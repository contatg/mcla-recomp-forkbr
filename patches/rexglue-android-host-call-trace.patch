 namespace rex {
@@ -71,6 +73,51 @@ int AndroidDiagnosticTid() {
   thread_local const int tid = gettid();
   return tid;
 }
+
+std::atomic<bool> android_trace_host_calls{false};
+thread_local uint32_t android_guest_caller = 0;
+
+namespace {
+struct HostCallTotals {
+  uint64_t calls = 0;
+  uint64_t ns = 0;
+};
+std::mutex host_calls_mutex;
+using HostCallKey = std::pair<int, const char*>;
+std::map<HostCallKey, HostCallTotals> host_calls;
+}
+
+void RecordAndroidHostCall(const char* name, uint64_t ns) {
+  std::lock_guard lock(host_calls_mutex);
+  auto& totals = host_calls[{AndroidDiagnosticTid(), name}];
+  ++totals.calls;
+  totals.ns += ns;
+}
+
+void LogAndroidHostCalls() {
+  std::map<HostCallKey, HostCallTotals> interval;
+  {
+    std::lock_guard lock(host_calls_mutex);
+    interval.swap(host_calls);
+  }
+  std::vector<std::pair<HostCallKey, HostCallTotals>> top(interval.begin(), interval.end());
+  std::sort(top.begin(), top.end(), [](const auto& a, const auto& b) {
+    if (a.first.first != b.first.first) return a.first.first < b.first.first;
+    return a.second.ns > b.second.ns;
+  });
+  int last_tid = 0;
+  unsigned rank = 0;
+  for (const auto& [key, totals] : top) {
+    const auto [tid, fn] = key;
+    if (tid != last_tid) {
+      last_tid = tid;
+      rank = 0;
+    }
+    if (++rank > 10) continue;
+    REXLOG_INFO("[hostcall] tid={} fn={} calls={} ms={:.3f}", tid, fn, totals.calls,
+                double(totals.ns) / 1e6);
+  }
+}
 #endif
 
