diff --git a/include/rex/android_diagnostics.h b/include/rex/android_diagnostics.h
new file mode 100644
index 0000000..4f02d29
--- /dev/null
+++ b/include/rex/android_diagnostics.h
@@ -0,0 +1,56 @@
+#pragma once
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_ANDROID
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace rex {
+enum class AndroidWait : unsigned { kEvent, kIo, kGpu, kWriteWatch, kCount };
+struct AndroidDiagnostics {
+  std::atomic<int> guest_tid{0};
+  std::atomic<int> pipelines_pending{0}, pipelines_preloading{0};
+  std::atomic<uint64_t> guest_updates{0};
+  std::atomic<const char*> swapchain_reason{"surface_outdated"};
+  std::atomic<uint64_t> frames{0}, presented{0}, pipelines_created{0};
+  std::atomic<uint64_t> read_bytes{0}, read_count{0}, read_ns{0};
+  std::atomic<const char*> last_vk_wait{"none"};
+  std::atomic<uint64_t> wait_ns[unsigned(AndroidWait::kCount)]{};
+  std::atomic<uint64_t> wait_sequence[unsigned(AndroidWait::kCount)]{};
+  std::atomic<uint64_t> active_since[unsigned(AndroidWait::kCount)]{};
+};
+
+AndroidDiagnostics& GetAndroidDiagnostics();
+int AndroidDiagnosticTid();
+
+inline uint64_t AndroidDiagnosticNow() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+class AndroidWaitScope {
+ public:
+  explicit AndroidWaitScope(AndroidWait kind) : index_(unsigned(kind)) {
+    auto& data = GetAndroidDiagnostics();
+    if (data.guest_tid.load(std::memory_order_relaxed) != AndroidDiagnosticTid()) return;
+    start_ = AndroidDiagnosticNow();
+    uint64_t empty = 0;
+    if (!data.active_since[index_].compare_exchange_strong(empty, start_)) start_ = 0;
+  }
+  ~AndroidWaitScope() {
+    if (!start_) return;
+    auto& data = GetAndroidDiagnostics();
+    data.wait_sequence[index_].fetch_add(1);
+    data.wait_ns[index_].fetch_add(AndroidDiagnosticNow() - start_);
+    data.active_since[index_].store(0);
+    data.wait_sequence[index_].fetch_add(1);
+  }
+
+ private:
+  unsigned index_;
+  uint64_t start_ = 0;
+};
+}  // namespace rex
+#endif
