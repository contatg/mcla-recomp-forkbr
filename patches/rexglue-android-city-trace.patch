+#if REX_PLATFORM_ANDROID
+void XObject::RecordDiagnosticSignal() {
+  if (!rex::GetAndroidDiagnostics().trace_guest_waits.load(std::memory_order_relaxed)) return;
+  static std::atomic<uint32_t> sequence{0};
+  diagnostic_signal_.store((uint64_t(sequence.fetch_add(1, std::memory_order_relaxed) + 1) << 32) |
+                           uint32_t(rex::AndroidDiagnosticTid()));
+}
+
+namespace {
+class GuestObjectWaitTrace {
+ public:
+  GuestObjectWaitTrace(XObject* const* objects, size_t count) {
+    auto& data = rex::GetAndroidDiagnostics();
+    if (!count || !data.trace_guest_waits.load(std::memory_order_relaxed) ||
+        rex::AndroidDiagnosticTid() != data.guest_tid.load(std::memory_order_relaxed)) return;
+    objects_ = objects;
+    count_ = std::min(count, signals_.size());
+    for (size_t i = 0; i < count_; ++i) signals_[i] = objects[i]->diagnostic_signal();
+    const auto& first = *objects[0];
+    data.wait_object.store((uint64_t(first.type()) << 32) | Address(first));
+    started_ = rex::AndroidDiagnosticNow();
+    data.wait_started_ns.store(started_);
+  }
+
+  void Finish(rex::thread::WaitResult result, size_t index = 0, bool all = false) {
+    if (!started_) return;
+    const auto duration = rex::AndroidDiagnosticNow() - started_;
+    rex::GetAndroidDiagnostics().wait_started_ns.store(0);
+    if (duration < 100000000) return;
+    const bool success = result == rex::thread::WaitResult::kSuccess;
+    if (success && !all && index >= count_) return;
+    const size_t end = success && !all ? index + 1 : count_;
+    for (size_t i = success && !all ? index : 0; i < end; ++i) {
+      const auto& object = *objects_[i];
+      const auto signal = object.diagnostic_signal();
+      const auto signaler = success && signals_[i] != signal ? uint32_t(signal) : 0;
+      REXLOG_INFO("[guestwait2] obj=0x{:08X} type={} waiter={} signaler={} ms={:.3f} "
+                  "result={} index={}/{} address_kind={}",
+                  Address(object), unsigned(object.type()), rex::AndroidDiagnosticTid(), signaler,
+                  double(duration) / 1e6, unsigned(result), i, count_,
+                  object.guest_object() ? "guest" : "handle");
+    }
+  }
+
+ private:
+  static uint32_t Address(const XObject& object) {
+    return object.guest_object() ? object.guest_object() : object.diagnostic_handle();
+  }
+  XObject* const* objects_ = nullptr;
+  std::array<uint64_t, 64> signals_;
+  size_t count_ = 0;
+  uint64_t started_ = 0;
+};
+}  // namespace
+#endif
